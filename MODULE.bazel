"""
Laminar Inference - Bazel Module Definition
Configures hermetic, polyglot build system for C++, Go, and Protobuf
"""

module(
    name = "laminar-inference",
    version = "1.0.0",
)

# Bazel dependencies
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.36.0")
bazel_dep(name = "protobuf", version = "29.1")
bazel_dep(name = "grpc", version = "1.62.1.bcr.1", repo_name = "com_github_grpc_grpc")

# Go dependencies configuration
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.12")

# Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Register all Go dependencies
use_repo(
    go_deps,
    "org_golang_google_grpc",
    "com_github_prometheus_client_golang",
)
